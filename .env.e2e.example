# Copy to .env.e2e (gitignored) and replace with your 1Password references.
E2E_USER=op://YOUR_VAULT/YOUR_TEST_ACCOUNT/username
E2E_PASSWORD=op://YOUR_VAULT/YOUR_TEST_ACCOUNT/password
E2E_TARGET=stage
# stage: https://console.stage.redhat.com
# production: https://console.redhat.com
# proxy: https://stage.foo.redhat.com:1337 (CI sidecar/local frontend proxy)
# Optional override for a different browser-facing origin:
# PLAYWRIGHT_BASE_URL=https://stage.foo.redhat.com:1337
# Optional corporate forward proxy (distinct from the frontend reverse proxy):
# PLAYWRIGHT_PROXY_SERVER=http://your-forward-proxy:port

# Optional exact visible labels. When unset, select the first available
# service/task, a required variant if present, and a supported file type through the UI.
# E2E_SERVICE=Inventory
# E2E_TASK=Export Systems
# E2E_FILE_TYPE=CSV

# Optional: existing schedule with a completed run and an unexpired ZIP export.
# E2E_DOWNLOAD_REPORT=Your seeded downloadable report

# Optional: deployed consumer integration, not /apps/scheduler-ui dev harness.
# E2E_CONSUMER_PATH=/path/to/consumer/report-page
# Ordered UI clicks from Console home; replace the example labels with the
# actual service menu and navigation labels in your environment.
# E2E_CONSUMER_NAVIGATION='[{"role":"button","name":"Your service menu"},{"role":"link","name":"Your reports page"}]'
# E2E_EXPORT_BUTTON=Export
